# Zkopíruj do .env a doplň vlastní klíče.

# MapTiler – podklad mapy (turistický styl). https://cloud.maptiler.com/account/keys/
VITE_MAPTILER_KEY=

# Služba Scorecast (výběr modelu podle měření stanic), bez lomítka
# na konci, např. https://scorecast.vercel.app. Prázdné = volba se skryje.
VITE_MODEL_API_URL=

# OpenWeatherMap – vrstva oblačnosti v radaru. https://home.openweathermap.org/api_keys
VITE_OWM_KEY=
